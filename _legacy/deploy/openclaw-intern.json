{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "GATEWAY_TOKEN_PLACEHOLDER" },
    "trustedProxies": ["127.0.0.1", "::1"]
  },
  "agents": {
    "defaults": {
      "sandbox": { "mode": "off", "scope": "agent", "workspaceAccess": "none" },
      "models": {},
      "model": { "primary": "cloudflare/workers-ai/@cf/nvidia/nemotron-3-120b-a12b" },
      "compaction": { "reserveTokensFloor": 20000 }
    },
    "list": [
      {
        "id": "ishtar-intern",
        "name": "ishtar-intern",
        "workspace": "/home/intern/agents/ishtar-intern/workspace",
        "agentDir": "/home/intern/.openclaw/agents/ishtar-intern/agent",
        "model": "cloudflare/workers-ai/@cf/nvidia/nemotron-3-120b-a12b",
        "identity": { "name": "Ishtar Intern", "theme": "claw" },
        "default": true
      }
    ]
  },
  "tools": { "deny": ["group:automation", "group:runtime", "group:fs"] },
  "plugins": {
    "entries": { "slack": { "enabled": true } },
    "allow": ["slack", "memory-core"]
  },
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "appToken": { "source": "env", "provider": "default", "id": "SLACK_APP_TOKEN" },
      "botToken": { "source": "env", "provider": "default", "id": "SLACK_BOT_TOKEN" },
      "dmPolicy": "pairing",
      "groupPolicy": "disabled",
      "slashCommand": { "enabled": true, "name": "intern", "ephemeral": true },
      "streaming": { "mode": "off" }
    }
  },
  "bindings": [{ "match": { "channel": "slack" }, "agentId": "ishtar-intern" }],
  "commands": { "ownerAllowFrom": ["slack:<OWNER_USER_ID>"] },
  "models": {
    "mode": "merge",
    "providers": {
      "cloudflare": {
        "baseUrl": "https://gateway.ai.cloudflare.com/v1/<CLOUDFLARE_ACCOUNT_ID>/ishtar-intern/compat",
        "apiKey": { "source": "env", "provider": "default", "id": "CF_AI_TOKEN_ISHTAR" },
        "api": "openai-completions",
        "models": [
          { "id": "workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast", "name": "Intern brain (llama-3.3-70b fallback)", "reasoning": false, "input": ["text"] },
          { "id": "workers-ai/@cf/nvidia/nemotron-3-120b-a12b", "name": "Intern brain (nemotron-3-120b)", "reasoning": false, "input": ["text"] }
        ]
      }
    }
  }
}
