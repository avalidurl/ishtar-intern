# /etc/ishtar-intern/env — chmod 600, owned root. Loaded by the systemd EnvironmentFile.
# Non-secret config:
CF_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
AI_GATEWAY_ID=ishtar-intern
CHAT_MODEL=@cf/nvidia/nemotron-3-120b-a12b
FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
DAILY_USD_BUDGET=5
MAX_TOKENS=1024
PORT=8787
DB_PATH=/opt/ishtar-intern/data/intern.db

# --- SECRETS (founder-provided; never commit real values) ---
# Scoped Cloudflare API token — Account › Workers AI = Read (NOTHING else). Low blast radius.
CF_AI_TOKEN=
# Slack app › Basic Information › Signing Secret
SLACK_SIGNING_SECRET=
# Slack app › OAuth & Permissions › Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
# Optional hard-lock: workspace id (T…) and your member id (U…). Blank = any user in the workspace.
SLACK_TEAM_ID=
SLACK_FOUNDER_USER_ID=
